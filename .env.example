TELRAAM_API_KEY=you_key_here
TELRAAM_SEGMENT_IDS=0000,0000,0000
DUCKDB_PATH=./path
LUCHTMEETNET_STATION_NUMBERS=XX00000,XX00000
# Optional — only needed for scripts/try_databricks_pull.py and Kafka exercises
